{
  "name": "mind3r-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Reminders (Frontend)",
  "keywords": [
    "reminder"
  ],
  "homepage": "https://github.com/chump29/mind3r",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/mind3r.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "bunx --bun vite build",
    "clean": "rimraf bun.lock ../.vscode dist",
    "clean:coverage": "rimraf coverage",
    "dev": "bunx --bun vite",
    "preinstall": "bunx only-allow bun",
    "postinstall": "link-configs && bun audit",
    "lint": "bun run lint:spell && bun run lint:biome && bun run lint:css && bun run lint:env && bun run lint:html",
    "lint:biome": "biome check --write --verbose",
    "lint:biome:ci": "biome ci --verbose --reporter=default --reporter=github",
    "lint:ci": "bun run lint:spell:ci && bun run lint:biome:ci && bun run lint:css:ci && bun run lint:env && bun run lint:html",
    "lint:css": "stylelint **/*.css --fix --formatter verbose --ignore-path ../.gitignore",
    "lint:css:ci": "stylelint **/*.css --formatter verbose --ignore-path ../.gitignore",
    "lint:env": "dotenv-linter check .",
    "lint:html": "html-validate *.html",
    "lint:spell": "cspell --dot --verbose .",
    "lint:spell:ci": "cspell --dot --verbose --config ./node_modules/@postfmly/config/.vscode/cspell.json .",
    "prepare": "cd .. && husky frontend/.husky",
    "prod": "bun run build && cd dist && bunx serve",
    "test": "bun run clean:coverage && bun test --coverage --isolate --coverage-reporter=text --coverage-reporter=lcov --preload ./src/dom-setup.ts --preload ./src/setup.ts"
  },
  "lint-staged": {
    "*": "cspell --no-must-find-files",
    "*.{json,ts,tsx}": "biome ci --no-errors-on-unmatched",
    "*.css": [
      "biome ci --no-errors-on-unmatched",
      "stylelint"
    ],
    ".env*": "dotenv-linter check",
    "*.html": "html-validate"
  },
  "browserslist": [
    "last 1 version"
  ],
  "overrides": {
    "@biomejs/biome": "^2.4.16",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0"
  },
  "dependencies": {
    "@jarrodek/pluralize": "^1.0.2",
    "@mantine/core": "^9.3.0",
    "@mantine/dates": "^9.3.0",
    "@mantine/form": "^9.3.0",
    "@mantine/modals": "^9.3.0",
    "@postfmly/logger": "^1.0.17",
    "@tabler/icons-react": "^3.44.0",
    "dayjs": "^1.11.21",
    "filter-data": "^0.6.1",
    "ms": "^2.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semver": "^7.8.1",
    "swr": "^2.4.1",
    "title-case": "^4.3.2",
    "valibot": "^1.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@aryzing/bun-mock-fetch": "^1.2.0",
    "@happy-dom/global-registrator": "^20.9.0",
    "@ngneat/falso": "^8.0.2",
    "@postfmly/config": "^1.3.13",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/ms": "^2.1.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "browserslist": "^4.28.2",
    "cspell": "^10.0.1",
    "fdir-size": "^1.0.3",
    "html-validate": "^11.5.0",
    "http-methods-constants": "^1.1.0",
    "http-status": "^2.1.0",
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lightningcss": "^1.32.0",
    "lint-staged": "^17.0.7",
    "pretty-bytes": "^7.1.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-jsx-remove-attributes": "^3.1.2",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16",
    "vite-plugin-minify": "^3.0.0",
    "vite-plugin-package-version": "^1.1.0",
    "vite-plugin-webfont-dl": "^3.12.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "~1.3.14"
  },
  "engineStrict": true,
  "patchedDependencies": {
    "@jarrodek/pluralize@1.0.2": "patches/@jarrodek%2Fpluralize@1.0.2.patch"
  }
}
